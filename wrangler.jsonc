// Cloudflare Workers config: serves the static website built in apps/web/dist.
// Cloudflare builds it with `pnpm --filter @miraflores/web build`, then runs `npx wrangler deploy`.
{
  "name": "miraflores",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
