---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import VillaNav from "../components/VillaNav.astro";
import BookCta from "../components/BookCta.astro";
import Reviews from "../components/Reviews.astro";
import { getVilla } from "../data/villas";
import { getAirports, site } from "../data/site";
import { villaSchema } from "../data/schema";
import { pick, t, paths, villaPath, villaAlternates, type Lang } from "../i18n";

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const villa = getVilla(lang, slug);
const sister = getVilla(lang, villa.sister);
const ui = t(lang);
const c = pick({
  welcomeEyebrow: { en: "Welcome", es: "Bienvenidos" },
  welcomeTo: { en: "Welcome to", es: "Bienvenidos a" },
  enSuite: { en: "en-suite suites", es: "suites con baño" },
  roomsEyebrow: { en: "Rooms", es: "Habitaciones" },
  elegantSuites: { en: "elegant suites", es: "suites elegantes" },
  seeRooms: { en: "See the rooms", es: "Ver las habitaciones" },
  amenEyebrow: { en: "Amenities", es: "Servicios" },
  amenTitle: { en: "Everything for a relaxing stay", es: "Todo para una estancia relajante" },
  seeAmen: { en: "See all amenities", es: "Ver todos los servicios" },
  locEyebrow: { en: "Location", es: "Ubicación" },
  gettingTo: { en: "Getting to", es: "Cómo llegar a" },
  locText: {
    en: "is in the heart of the Costa Tropical, within easy driving distance of Málaga and Granada, their culture, history and airports.",
    es: "está en el corazón de la Costa Tropical, a poca distancia en coche de Málaga y Granada, su cultura, su historia y sus aeropuertos.",
  },
  guide1: { en: "We've written a free", es: "Hemos preparado una" },
  guidebook: { en: "guidebook", es: "guía gratuita" },
  guide2: { en: "for our guests, and our", es: "para nuestros huéspedes, y en nuestra página" },
  thingsToDo: { en: "things to do", es: "qué hacer" },
  guide3: { en: "page has our favourite trips.", es: "encontrarás nuestras excursiones favoritas." },
  also: { en: "Also by our family", es: "También de nuestra familia" },
}, lang);
---
<Base
  lang={lang}
  title={villa.seoTitle}
  description={villa.seoDescription}
  image={villa.hero.src}
  alternates={villaAlternates(slug, "overview")}
  breadcrumbs={[{ name: villa.name, href: villaPath(lang, slug) }]}
  jsonLd={[await villaSchema(villa, lang)]}
>
  <Hero image={villa.hero} eyebrow={`${villa.locality} · Costa Tropical`} title={villa.name} subtitle={villa.tagline}>
    <div class="actions">
      <a class="btn light" href={villa.booking.airbnb} target="_blank" rel="noopener">{ui.bookAirbnb}</a>
    </div>
  </Hero>
  <VillaNav villa={villa} lang={lang} />

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">{c.welcomeEyebrow}</span>
        <h2>{c.welcomeTo} {villa.name}</h2>
        {villa.intro.map((p) => <p>{p}</p>)}
        <ul class="ticks facts">
          <li>{villa.facts.suites} {c.enSuite}</li>
          <li>{villa.facts.guests}</li>
        </ul>
      </div>
      <Image src={villa.cover.src} alt={villa.cover.alt} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
    </div>
  </section>

  <section class="section alt">
    <div class="container grid cols-3">
      {villa.highlights.map((h) => (
        <article class="card">
          <Image src={h.image.src} alt={h.image.alt} widths={[400, 700]} sizes="(max-width: 900px) 100vw, 380px" />
          <div class="body"><h3>{h.title}</h3><p>{h.text}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <Image src={villa.rooms.image.src} alt={villa.rooms.image.alt} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
      <div>
        <span class="eyebrow">{c.roomsEyebrow}</span>
        <h2>{villa.facts.suites} {c.elegantSuites}</h2>
        <p>{villa.rooms.intro}</p>
        <a class="btn ghost" href={villaPath(lang, slug, "rooms")}>{c.seeRooms}</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <span class="eyebrow">{c.amenEyebrow}</span>
      <h2>{c.amenTitle}</h2>
      <p class="lead">{villa.poolBlurb}</p>
      <ul class="ticks amen">{villa.keyAmenities.map((a) => <li>{a}</li>)}</ul>
      <div class="actions"><a class="btn ghost" href={villaPath(lang, slug, "amenities")}>{c.seeAmen}</a></div>
    </div>
  </section>

  <Reviews lang={lang} villaSlug={slug} title={slug === "villa-los-olivos" ? `${ui.reviews.villaTitle} ${villa.name}` : undefined} />

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">{c.locEyebrow}</span>
        <h2>{c.gettingTo} {villa.name}</h2>
        <p>{villa.name} {c.locText}</p>
        <ul class="ticks">{getAirports(lang).map((a) => <li>{a.name}: {a.distance}</li>)}</ul>
        <p class="guide">{c.guide1} <a href={site.airbnbGuidebook} rel="noopener">{c.guidebook}</a> {c.guide2} <a href={paths.thingsToDo[lang]}>{c.thingsToDo}</a> {c.guide3}</p>
      </div>
      <a class="card sister" href={villaPath(lang, sister.slug)}>
        <Image src={sister.cover.src} alt={sister.cover.alt} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 560px" />
        <div class="body">
          <span class="eyebrow">{c.also}</span>
          <h3>{sister.name}, {sister.locality}</h3>
          <p>{sister.summary}</p>
        </div>
      </a>
    </div>
  </section>

  <BookCta villa={villa} lang={lang} />
</Base>

<style>
  .facts { margin-top: 20px; font-weight: 600; }
  .amen { margin-top: 28px; }
  .sister { color: inherit; text-decoration: none; }
  .sister img { border-radius: 0; }
  .guide { margin-top: 20px; }
</style>
