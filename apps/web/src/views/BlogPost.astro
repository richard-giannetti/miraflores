---
import { Image, getImage } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { getVillas } from "../data/villas";
import { site } from "../data/site";
import { pick, paths, categories, categoryPath, dateLocale, villaPath, postPath, type Lang } from "../i18n";
import { postAlternates, postSlug } from "../i18n/blog";

interface Props { lang: Lang; post: CollectionEntry<"blog"> }
const { lang, post } = Astro.props;
const { Content } = await render(post);
const url = new URL(postPath(lang, postSlug(post)), site.url).href;
const fmt = new Intl.DateTimeFormat(dateLocale[lang], { day: "numeric", month: "long", year: "numeric" });
const cover = post.data.cover && new URL((await getImage({ src: post.data.cover, width: 1200, format: "jpg" })).src, site.url).href;
const c = pick({
  back: { en: "← Blog", es: "← Blog" },
  stayTitle: { en: "Stay with us on the Costa Tropical", es: "Alójate con nosotros en la Costa Tropical" },
  stayLead: { en: "Explore it all from one of our family's villas.", es: "Descúbrelo todo desde una de las villas de nuestra familia." },
}, lang);

const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  inLanguage: lang,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: url,
  ...(cover && { image: cover }),
  author: { "@type": "Organization", name: site.name, url: site.url },
  publisher: { "@type": "Organization", name: site.name, url: site.url },
};
---
<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  jsonLd={[article]}
  alternates={await postAlternates(post)}
  breadcrumbs={[{ name: "Blog", href: paths.blog[lang] }, { name: post.data.title, href: postPath(lang, postSlug(post)) }]}
>
  <article class="section">
    <div class="narrow">
      <a href={paths.blog[lang]}>{c.back}</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
        {post.data.categories.map((k) => categories[k] && <> · <a href={categoryPath(lang, k)}>{categories[k].name[lang]}</a></>)}
      </p>
      {post.data.cover && <Image class="cover" src={post.data.cover} alt="" widths={[700, 1200]} sizes="(max-width: 800px) 100vw, 760px" loading="eager" />}
      <div class="prose"><Content /></div>
    </div>
  </article>

  <section class="section alt">
    <div class="narrow center">
      <h2>{c.stayTitle}</h2>
      <p class="lead">{c.stayLead}</p>
      <div class="actions">{getVillas(lang).map((v) => <a class="btn ghost" href={villaPath(lang, v.slug)}>{v.name}</a>)}</div>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin-top: 18px; }
  .meta { color: var(--muted); }
  .cover { border-radius: var(--radius); margin: 28px 0 36px; width: 100%; }
</style>
