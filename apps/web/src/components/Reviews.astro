---
import { airbnbRating, reviews } from "../data/reviews";
import { getVilla } from "../data/villas";
import { pick, dateLocale, villaPath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title?: string;
  // The villa whose page this is; when it isn't the reviewed villa, say whose reviews these are.
  villaSlug?: string;
}
const { lang, villaSlug } = Astro.props;
const reviewed = getVilla(lang, airbnbRating.villa);
const isSister = villaSlug !== undefined && villaSlug !== airbnbRating.villa;
const month = new Intl.DateTimeFormat(dateLocale[lang], { month: "long", year: "numeric" });
const num = (n: number, digits = 1) => n.toLocaleString(dateLocale[lang], { minimumFractionDigits: digits, maximumFractionDigits: digits });
const c = pick({
  eyebrow: { en: "Airbnb reviews", es: "Opiniones en Airbnb" },
  title: { en: "What our guests say", es: "Lo que dicen nuestros huéspedes" },
  sister: { en: "Reviews of our sister villa,", es: "Opiniones de nuestra otra villa," },
  favourite: { en: "Guest favourite on Airbnb", es: "Favorito entre huéspedes en Airbnb" },
  reviews: { en: "reviews", es: "opiniones" },
  outOf: { en: "out of 5", es: "de 5" },
  cleanliness: { en: "Cleanliness", es: "Limpieza" },
  accuracy: { en: "Accuracy", es: "Veracidad" },
  checkIn: { en: "Check-in", es: "Llegada" },
  communication: { en: "Communication", es: "Comunicación" },
  location: { en: "Location", es: "Ubicación" },
  value: { en: "Value", es: "Calidad-precio" },
  translated: { en: "Translated by Airbnb", es: "Traducida por Airbnb" },
  all: { en: "Read all reviews on Airbnb", es: "Ver todas las opiniones en Airbnb" },
  stars: { en: "5 out of 5 stars", es: "5 de 5 estrellas" },
}, lang);
const title = Astro.props.title ?? c.title;
const cats = Object.entries(airbnbRating.categories) as [keyof typeof airbnbRating.categories, number][];
---
<section class="section">
  <div class="container">
    <div class="center">
      <span class="eyebrow">{c.eyebrow}</span>
      <h2>{title}</h2>
      {isSister && <p class="lead">{c.sister} <a href={villaPath(lang, reviewed.slug)}>{reviewed.name}</a>.</p>}
    </div>

    <div class="rating">
      <div class="score">
        <strong>{num(airbnbRating.overall, 2)}</strong>
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span class="sr-only">{num(airbnbRating.overall, 2)} {c.outOf}</span>
      </div>
      <div class="meta">
        {airbnbRating.guestFavourite && <p class="fav">{c.favourite}</p>}
        <p>{reviewed.name} · {airbnbRating.count} {c.reviews}</p>
      </div>
      <dl class="cats">
        {cats.map(([k, v]) => <div><dt>{c[k]}</dt><dd>{num(v)}</dd></div>)}
      </dl>
    </div>

    <div class="list">
      {reviews.map((r) => (
        <figure lang="en">
          <div class="top">
            <span class="avatar" aria-hidden="true">{r.author[0]}</span>
            <div>
              <figcaption>{r.author}</figcaption>
              <span class="date" lang={lang}><span class="stars" aria-label={c.stars}>★★★★★</span> · {month.format(new Date(`${r.date}-15`))}</span>
            </div>
          </div>
          <blockquote>{r.text}</blockquote>
          {r.translated && <p class="note" lang={lang}>{c.translated}</p>}
        </figure>
      ))}
    </div>

    <div class="actions" style="justify-content:center">
      <a class="btn ghost" href={airbnbRating.listing} target="_blank" rel="noopener">{c.all}</a>
    </div>
  </div>
</section>

<style>
  .rating { margin: 36px auto 32px; max-width: 900px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 28px; display: grid; gap: 18px 32px; grid-template-columns: auto 1fr; align-items: center; }
  .score { display: grid; justify-items: center; }
  .score strong { font: 500 3.2rem/1 var(--serif); }
  .stars { color: #c99a2e; letter-spacing: 2px; font-size: .9rem; }
  .meta p { margin: 0; color: var(--muted); }
  .meta .fav { color: var(--ink); font-weight: 600; font-size: 1.05rem; }
  .cats { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px 28px; margin: 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .cats div { display: flex; justify-content: space-between; gap: 8px; }
  dt { color: var(--muted); font-size: .9rem; }
  dd { margin: 0; font-weight: 600; }
  .list { columns: 3 300px; column-gap: 24px; }
  figure { break-inside: avoid; margin: 0 0 24px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .top { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
  .avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--sand); color: var(--olive); display: grid; place-items: center; font: 600 1.1rem var(--sans); flex: none; }
  figcaption { font-weight: 600; }
  .date { color: var(--muted); font-size: .85rem; }
  blockquote { margin: 0; color: var(--ink); font-size: .98rem; }
  .note { margin: 10px 0 0; font-size: .8rem; color: var(--muted); }
  @media (max-width: 560px) { .rating { grid-template-columns: 1fr; text-align: center; } }
</style>
