---
import type { Villa } from "../data/villas";

interface Props { villa: Villa }
const { villa } = Astro.props;
const base = `/${villa.slug}/`;
const links = [
  { href: base, label: "Overview" },
  { href: `${base}rooms/`, label: "Rooms" },
  { href: `${base}amenities/`, label: "Amenities" },
  { href: `${base}gallery/`, label: "Gallery" },
];
---
<nav class="villa-nav" aria-label={`${villa.name} pages`}>
  <div class="container">
    {links.map((l) => <a href={l.href} aria-current={Astro.url.pathname === l.href ? "page" : undefined}>{l.label}</a>)}
    <a class="book" href={villa.booking.airbnb} rel="noopener">Book on Airbnb</a>
  </div>
</nav>

<style>
  .villa-nav { background: #fff; border-bottom: 1px solid var(--line); }
  .container { display: flex; gap: 4px 26px; overflow-x: auto; white-space: nowrap; align-items: center; }
  a { padding: 16px 0; color: var(--muted); text-decoration: none; font-size: .95rem; border-bottom: 2px solid transparent; }
  a[aria-current] { color: var(--ink); border-color: var(--olive); }
  .book { margin-left: auto; color: var(--olive); font-weight: 600; }
</style>
