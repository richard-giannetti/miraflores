---
import type { Villa } from "../data/villas";
import { t, villaPath, type Lang, type VillaPage } from "../i18n";

interface Props { villa: Villa; lang: Lang }
const { villa, lang } = Astro.props;
const ui = t(lang);
const pages: VillaPage[] = ["overview", "rooms", "amenities", "gallery"];
---
<nav class="villa-nav" aria-label={villa.name}>
  <div class="container">
    {pages.map((p) => {
      const href = villaPath(lang, villa.slug, p);
      return <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{ui.villaNav[p]}</a>;
    })}
    <a class="book" href={villa.booking.airbnb} target="_blank" rel="noopener">{ui.bookAirbnb}</a>
  </div>
</nav>

<style>
  .villa-nav { background: #fff; border-bottom: 1px solid var(--line); }
  .container { display: flex; gap: 4px 26px; overflow-x: auto; white-space: nowrap; align-items: center; }
  a { padding: 16px 0; color: var(--muted); text-decoration: none; font-size: .95rem; border-bottom: 2px solid transparent; }
  a[aria-current] { color: var(--ink); border-color: var(--olive); }
  .book { margin-left: auto; color: var(--olive); font-weight: 600; }
</style>
