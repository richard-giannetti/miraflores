---
import type { Villa } from "../data/villas";

interface Props { villa: Villa }
const { villa } = Astro.props;
---
<section class="section cta">
  <div class="narrow center">
    <span class="eyebrow">Book your stay</span>
    <h2>Book your stay at {villa.name}</h2>
    <p class="lead">Book directly on Airbnb, or write to us and we'll help you plan your getaway.</p>
    <div class="actions">
      <a class="btn" href={villa.booking.airbnb} rel="noopener">Book on Airbnb</a>
      {villa.booking.vrbo && <a class="btn ghost" href={villa.booking.vrbo} rel="noopener">Book on Vrbo</a>}
      <a class="btn ghost" href="/contact/">Contact us</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--sand); }
</style>
