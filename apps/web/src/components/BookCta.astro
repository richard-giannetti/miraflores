---
import type { Villa } from "../data/villas";
import { t, paths, type Lang } from "../i18n";
import BookDirect from "./BookDirect.astro";

interface Props { villa: Villa; lang: Lang }
const { villa, lang } = Astro.props;
const ui = t(lang);
---
<section class="section cta">
  <div class="narrow center">
    <span class="eyebrow">{ui.bookCta.eyebrow}</span>
    <h2>{ui.bookCta.title} {villa.name}</h2>
    <p class="lead">{ui.bookCta.lead}</p>
    <div class="actions">
      <a class="btn" href={villa.booking.airbnb} target="_blank" rel="noopener">{ui.bookAirbnb}</a>
      <a class="btn ghost" href={paths.contact[lang]}>{ui.contactUs}</a>
    </div>
    <BookDirect villa={villa} lang={lang} />
  </div>
</section>

<style>
  .cta { background: var(--sand); }
</style>
