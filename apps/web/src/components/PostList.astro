---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props { posts: CollectionEntry<"blog">[] }
const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<div class="grid cols-3">
  {posts.map((p) => (
    <a class="card post" href={`/blog/${p.id}/`}>
      {p.data.cover && <Image src={p.data.cover} alt="" widths={[400, 700]} sizes="(max-width: 900px) 100vw, 380px" />}
      <div class="body">
        <time datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
        <h2>{p.data.title}</h2>
        <p>{p.data.description}</p>
      </div>
    </a>
  ))}
</div>

<style>
  .post { color: inherit; text-decoration: none; }
  time { font-size: .85rem; color: var(--muted); }
  h2 { font-size: 1.45rem; margin: 6px 0 10px; font-weight: 600; }
  p { color: var(--muted); font-size: .97rem; }
</style>
