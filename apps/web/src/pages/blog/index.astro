---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { categories } from "../../data/categories";

const posts = (await getCollection("blog")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
---
<Base
  title="Costa Tropical Travel Blog — Insider Tips & Day Trips"
  description="Our family's insider tips for the Costa Tropical: day trips to Granada and Nerja, hidden beaches like La Rijana, canyoning and more. Not sponsored, no commissions."
  breadcrumbs={[{ name: "Blog", href: "/blog/" }]}
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1>Discover the Costa Tropical's best-kept secrets</h1>
      <p class="lead">Insider tips, travel guides and hidden gems, all chosen by our family. Nothing here is sponsored and we take no commissions: we just want our guests to enjoy the very best of the region.</p>
      <nav class="cats" aria-label="Categories">
        {Object.entries(categories).map(([slug, name]) => <a href={`/blog/category/${slug}/`}>{name}</a>)}
      </nav>
      <PostList posts={posts} />
    </div>
  </section>
</Base>

<style>
  .cats { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 40px; }
  .cats a { padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; background: #fff; font-size: .9rem; }
</style>
