---
import BlogPost from "../../views/BlogPost.astro";
import { getPosts, postSlug } from "../../i18n/blog";

export const getStaticPaths = async () =>
  (await getPosts("en")).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
---
<BlogPost lang="en" post={Astro.props.post} />
